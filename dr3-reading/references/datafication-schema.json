{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Datafication Schema v1.2",
  "description": "DR3 Datafication output schema with claim-level provenance and evidence consistency",
  "type": "object",
  "required": ["applicable", "structures", "relations", "conceptualization", "rejected_candidates", "stats"],
  "properties": {
    "applicable": {
      "type": "boolean",
      "description": "Whether the article contains datifiable structures"
    },
    "structures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "name", "scope", "origin", "status", "structure"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^DS-[0-9]{2}$",
            "description": "Structure ID, format DS-XX"
          },
          "type": {
            "type": "string",
            "enum": ["process", "classification", "criteria", "decision_rule", "framework", "comparison", "scale", "enumeration", "relationship", "concept_system"],
            "description": "Structure type"
          },
          "name": {
            "type": "string",
            "description": "Structure name"
          },
          "scope": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": {
                "type": "string",
                "enum": ["local", "article"],
                "description": "Scope type: local (paragraph/section) or article-wide"
              },
              "paragraphs": {
                "type": "array",
                "items": { "type": "integer" },
                "description": "Paragraph range for local scope"
              },
              "description": {
                "type": "string",
                "description": "Description of scope"
              }
            }
          },
          "origin": {
            "type": "string",
            "enum": ["explicit", "reconstructed", "inferred"],
            "description": "How the structure was derived"
          },
          "status": {
            "type": "string",
            "enum": ["author_asserted", "partially_supported", "reconstructed", "refuted"],
            "description": "Evidence-based status of the structure"
          },
          "structure": {
            "type": "object",
            "description": "The actual structure content (varies by type)"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["paragraph", "quote", "claim", "semantic_strength"],
              "properties": {
                "paragraph": {
                  "type": "integer",
                  "description": "Paragraph number in source"
                },
                "quote": {
                  "type": "string",
                  "description": "Direct quote from source"
                },
                "claim": {
                  "type": "string",
                  "description": "What this evidence supports"
                },
                "semantic_strength": {
                  "type": "string",
                  "enum": ["fact", "inference", "interpretation", "assumption"],
                  "description": "Semantic strength of the evidence"
                },
                "inferred": {
                  "type": "boolean",
                  "default": false,
                  "description": "Whether this is model-inferred (not author-explicit)"
                }
              }
            },
            "description": "Evidence supporting this structure"
          },
          "rejection_reason": {
            "type": "string",
            "description": "If status is refuted, why this structure was rejected"
          }
        }
      },
      "description": "List of discovered structures"
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "type"],
        "properties": {
          "from": {
            "type": "string",
            "description": "Source structure ID"
          },
          "to": {
            "type": "string",
            "description": "Target structure ID"
          },
          "type": {
            "type": "string",
            "enum": ["depends_on", "enables", "conflicts_with", "is_part_of", "precedes", "succeeds"],
            "description": "Relationship type"
          },
          "evidence": {
            "type": "string",
            "description": "Evidence supporting this relationship"
          },
          "inferred": {
            "type": "boolean",
            "default": false,
            "description": "Whether this relationship is inferred"
          }
        }
      },
      "description": "Relationships between structures"
    },
    "conceptualization": {
      "type": "object",
      "required": ["detected"],
      "properties": {
        "detected": {
          "type": "boolean",
          "description": "Whether article-level conceptualization is detected"
        },
        "scope": {
          "type": "string",
          "description": "Description of conceptualization scope"
        },
        "coherence": {
          "type": "string",
          "enum": ["high", "medium", "low"],
          "description": "Coherence level of conceptualization"
        },
        "evidence": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Evidence supporting conceptualization"
        }
      },
      "description": "Article-level conceptualization (if any)"
    },
    "rejected_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "reason"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Candidate name"
          },
          "reason": {
            "type": "string",
            "description": "Why this candidate was rejected"
          },
          "type": {
            "type": "string",
            "description": "Candidate type"
          }
        }
      },
      "description": "Candidates that were considered but rejected"
    },
    "stats": {
      "type": "object",
      "required": ["structures", "explicit", "reconstructed", "inferred"],
      "properties": {
        "structures": {
          "type": "integer",
          "description": "Total number of structures"
        },
        "explicit": {
          "type": "integer",
          "description": "Number of explicitly stated structures"
        },
        "reconstructed": {
          "type": "integer",
          "description": "Number of reconstructed structures"
        },
        "inferred": {
          "type": "integer",
          "description": "Number of inferred structures"
        }
      }
    }
  }
}
